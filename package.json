{
  "name": "cerenbuilds-editor",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c auto \"npm -w @cb/server run dev\" \"npm -w @cb/web run dev\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "test:browser": "node apps/web/e2e/editor.e2e.mjs",
    "test:parity": "tsx packages/renderer/test/parity.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15"
  }
}
